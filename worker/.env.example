# ── media-worker-m8 environment ──────────────────────────────────────────────
# Copy to `worker/.env` and fill in real values. Every secret below MUST stay
# the literal `changethis` here (fail-closed); set strong values only in the
# real `.env`. Complexity rules live in the comments, never in the placeholder.

# ── Runtime posture ──────────────────────────────────────────────────────────
# Trust posture, aligned with the auth/media services. `local` (home-lab
# default) tolerates the `changethis` placeholders below so the example stack
# boots. Under `production` (or STRICT_PRODUCTION_MODE=true) the worker FAILS
# CLOSED at boot if MEDIA_INTERNAL_SERVICE_TOKEN, MINIO_ACCESS_KEY,
# MINIO_SECRET_KEY, or (when MEDIA_REDIS_USER is set) MEDIA_REDIS_PASSWORD is
# empty or still `changethis`. Allowed: local|development|staging|production.
ENVIRONMENT=local
# Force the production trust posture regardless of ENVIRONMENT.
STRICT_PRODUCTION_MODE=false

# ── Media-service internal API ───────────────────────────────────────────────
# Base URL INCLUDING the API prefix; the worker appends /v1/internal/... to it.
MEDIA_API_URL=http://media-service:8000/media
# Dedicated bearer token for worker→service callbacks. Must match
# media-service MEDIA_INTERNAL_SERVICE_TOKEN. Use a high-entropy random value
# (>=32 chars) in real environments. Must NOT equal MEDIA_REDIS_PASSWORD or
# MINIO_SECRET_KEY.
MEDIA_INTERNAL_SERVICE_TOKEN=changethis
# Stable identity sent as X-Worker-Client on every internal callback.
# Identifies this worker to media-service for attribution/audit.
WORKER_CLIENT_ID=media-worker
MEDIA_API_TIMEOUT_SECONDS=10

# ── Media Redis (ARQ queue) ──────────────────────────────────────────────────
MEDIA_REDIS_HOST=media_redis_cache
MEDIA_REDIS_PORT=6379
MEDIA_REDIS_USER=appuser
# Leave empty for no auth (local only); strong password (>=16 chars) in prod.
MEDIA_REDIS_PASSWORD=changethis
MEDIA_REDIS_NAMESPACE=media

# ── MinIO / object storage ───────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=eu-west-1
MINIO_ACCESS_KEY=changethis
# Strong secret (>=16 chars) in prod.
MINIO_SECRET_KEY=changethis
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=300

# ── ClamAV daemon (clamav compose service) ───────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120

# ── ARQ tuning ───────────────────────────────────────────────────────────────
WORKER_MAX_TRIES=5
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_KEEP_RESULT_SECONDS=3600
# Max jobs run concurrently (ARQ max_jobs). Bounds peak memory together with the
# per-job source/decoded ceilings; size the container memory limit for roughly
# WORKER_MAX_CONCURRENT_JOBS × (decoded image + output budget).
WORKER_MAX_CONCURRENT_JOBS=4

# ── Variant cost ceilings (local safety, defense in depth) ───────────────────
# Worker-local ceilings that refuse unsafe variant jobs at this runtime's trust
# boundary even if a malformed/stale job bypasses media-service. media-service
# remains the request-policy owner — keep these as safety ceilings, not policy.
# Max source object size (bytes) accepted from storage metadata before download.
WORKER_MAX_SOURCE_BYTES=67108864
# Max number of variant outputs rendered per job (fan-out bound).
WORKER_MAX_OUTPUTS_PER_JOB=32
# Max total written output bytes per job (storage-write amplification bound).
WORKER_MAX_OUTPUT_BYTES=134217728
# Wall-clock ceiling (seconds) for one render call; must be
# <= WORKER_JOB_TIMEOUT_SECONDS so the job fails cleanly before ARQ kills it.
WORKER_IMAGE_PROCESS_TIMEOUT_SECONDS=120

# ── Memory guards (streaming scan + decompression-bomb defense) ──────────────
# Max source object size (bytes) accepted on the SCAN path, from metadata before
# streaming. Scanning streams chunk-by-chunk so memory stays bounded; this only
# caps abuse and must stay <= the clamd StreamMaxLength. Over-ceiling or
# unknown-size objects fail closed (quarantined, never marked clean). Larger
# than the variant ceiling because scanning also covers non-image uploads.
WORKER_MAX_SCAN_BYTES=268435456
# Max decoded pixels (width × height) for a variant source, read from the image
# header before the full decode — defends against decompression bombs. 50 MP ≈
# 200 MB at RGBA; pair with WORKER_MAX_CONCURRENT_JOBS and a container mem limit.
WORKER_MAX_DECODED_PIXELS=50000000
