# Compose env for media-worker-m8. Copy to `worker.env` and fill real values.
# Secrets MUST stay the literal `changethis` here (fail-closed); set strong
# values only in the real `worker.env`. These MUST match the hardened media
# stack (media.env): same S3 creds, same MEDIA_REDIS_PASSWORD, and the same
# MEDIA_INTERNAL_SERVICE_TOKEN as media-service.

# ── Media-service internal API ───────────────────────────────────────────────
# In-cluster URL including the API prefix; the worker appends /v1/internal/...
MEDIA_API_URL=http://media_service:8000/media
# Dedicated bearer token for worker→service callbacks. Must match
# MEDIA_INTERNAL_SERVICE_TOKEN in the media stack. Must NOT equal
# MEDIA_REDIS_PASSWORD or S3_SECRET_KEY (fail-closed isolation).
# Value: only 'not changethis' is enforced; use 32+ random chars, no max;
#   letters, digits and - _ . ~ only.
MEDIA_INTERNAL_SERVICE_TOKEN=changethis
# Stable identity sent as X-Worker-Client on every internal callback.
WORKER_CLIENT_ID=media-worker

# ── Media Redis (ARQ queue) ──────────────────────────────────────────────────
# Hostname of the media Redis (job queue and rate limits).
MEDIA_REDIS_HOST=media_redis_cache
# Media Redis port (1-65535, default 6379).
MEDIA_REDIS_PORT=6379
# Media Redis ACL user (default media).
MEDIA_REDIS_USER=appuser
# Password of MEDIA_REDIS_USER on the media Redis ACL.
# Value: only 'not changethis' is enforced; use 32+ random chars, no max;
#   letters, digits and - _ . ~ only.
MEDIA_REDIS_PASSWORD=changethis
# Key prefix for media keys in Redis (default media).
MEDIA_REDIS_NAMESPACE=media

# ── S3 / object storage ──────────────────────────────────────────────────────
# S3 endpoint as host[:port] (no scheme; TLS is S3_USE_SSL).
S3_ENDPOINT=minio:9000
# Use HTTPS to reach S3_ENDPOINT (true | false).
S3_USE_SSL=false
# S3 region name sent in SigV4 signatures (any value the backend accepts).
S3_REGION=eu-west-1
# S3 access key id the service signs requests with.
# Value: the storage backend enforces no format; use 20+ chars, letters and
#   digits only (AWS-style access key id).
S3_ACCESS_KEY=changethis
# S3 secret key paired with S3_ACCESS_KEY.
# Value: the storage backend enforces no format; use 40+ chars, letters and
#   digits only (AWS-style secret key).
S3_SECRET_KEY=changethis

# ── ClamAV daemon ────────────────────────────────────────────────────────────
# Hostname of the clamd daemon the worker streams uploads to for virus
# scanning.
CLAMAV_HOST=clamav
# clamd TCP port (1-65535, default 3310).
CLAMAV_PORT=3310
